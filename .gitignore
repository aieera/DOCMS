# Secrets & local config
.mcp.json
.claude/settings.local.json
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Go build output
/bin/
/dist/
*.exe
*.test
*.out
coverage.txt
coverage.html

# Generated code (uncomment if you choose to gitignore generated protos)
# proto/vaultdms/v1/*.pb.go
# proto/vaultdms/v1/*.pb.gw.go

# Frontend build-time generated index (regenerated on every `npm run dev`
# and `npm run build` via scripts/build-load-test-index.mjs — see web/package.json).
# Tracking it only produces timestamp churn in every diff.
web/src/generated/

# Python (intelligence + preview workers)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Node / frontend
node_modules/
.pnpm-store/
.next/
.turbo/
# Vite build output — the root-level `/dist/` rule above is anchored
# to the repo root and misses `web/dist/`. This catches it (and any
# future per-package dist dirs) explicitly.
dist/
web/dist/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker / volumes
.docker/
volumes/

# Logs & tmp
*.log
tmp/
.cache/

# Snapshots generated by scripts/snapshot-for-claude.sh
snapshots/

# Tooling artifacts (Playwright MCP, route-audit screenshots, scheduler lockfile)
.playwright-mcp/
web/.audit/
.claude/scheduled_tasks.lock
# Auto-generated local Claude agent (shared project agents are still tracked)
.claude/agents/debugger.md

# Local-only ops/monitoring scaffolding (deployable config lives under deploy/)
ops/

# Scratch reports + planning docs — kept out of the tree (removed in 66960b3).
# Real product docs live under docs/{adr,architecture,howto,deploy,...}.
/snap-*.md
/bug-fix-report-*.md
docs/reports/
docs/followups/

# Runtime artifacts from scripts/dev-up.sh
.run/

# Ansible secrets (ADR 0093) — vault password + encrypted vars + real inventory
deploy/ansible/.vault-password
deploy/ansible/group_vars/*.vault.yml
deploy/ansible/inventories/*.ini
!deploy/ansible/inventories/example.ini
deploy/ansible/host_vars/
deploy/license/dev.priv.pem

# Playwright failure artefacts — per-failure folders with error-context.md +
# test-failed-N.png + video.webm + diff screenshots. Regenerated on every
# failing test run; two folders previously slipped into the repo from a
# 2026-04-19 RTL run and were removed alongside this gitignore entry.
web/test-results/
web/playwright-report/
