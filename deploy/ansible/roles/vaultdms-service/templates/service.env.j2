# Environment for vaultdms-{{ vaultdms_service_name }} — managed by ansible.
# Edits here are overwritten on the next playbook run.

VAULTDMS_SERVICE_NAME={{ vaultdms_service_name }}
VAULTDMS_GRPC_PORT={{ vaultdms_service_grpc_port }}
VAULTDMS_HTTP_PORT={{ vaultdms_service_http_port }}
VAULTDMS_HEALTH_PORT={{ vaultdms_service_health_port }}

VAULTDMS_DATABASE_URL=postgres://{{ vaultdms_db_user }}:{{ vault_db_password | default('CHANGEME') }}@{{ vaultdms_db_host }}:{{ vaultdms_db_port }}/{{ vaultdms_db_name }}?sslmode=disable
VAULTDMS_REDIS_URL={{ vaultdms_cache_host }}:{{ vaultdms_cache_port }}
VAULTDMS_NATS_URL={{ vaultdms_nats_url }}
VAULTDMS_OPENSEARCH_URL={{ vaultdms_search_url }}
VAULTDMS_S3_ENDPOINT={{ vaultdms_s3_endpoint }}
VAULTDMS_TEMPORAL_ADDR={{ vaultdms_temporal_addr }}
VAULTDMS_PUBLIC_URL={{ vaultdms_public_url }}

VAULTDMS_LOCAL_KEK={{ vault_local_kek | default('') }}
VAULTDMS_GATEWAY_SECRET={{ vault_gateway_secret | default('') }}
VAULTDMS_INTERNAL_API_KEY={{ vault_internal_api_key | default('') }}
VAULTDMS_ESIGN_STATE_HMAC={{ vault_esign_state_hmac | default('') }}

{% for k, v in vaultdms_service_extra_env.items() %}
{{ k }}={{ v }}
{% endfor %}
