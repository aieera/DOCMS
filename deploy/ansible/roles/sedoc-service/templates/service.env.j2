# Environment for vaultdms-{{ vaultdms_service_name }} — managed by ansible.
# Edits here are overwritten on the next playbook run.
#
# Every secret below comes from Ansible Vault with no default; the role
# asserts each one is set before this file is rendered (O-11).

SEDOC_SERVICE_NAME={{ vaultdms_service_name }}
SEDOC_GRPC_PORT={{ vaultdms_service_grpc_port }}
SEDOC_HTTP_PORT={{ vaultdms_service_http_port }}
SEDOC_HEALTH_PORT={{ vaultdms_service_health_port }}

# Deployment identity (C-2, DEC-5, DEC-11).
SEDOC_ENVIRONMENT={{ vaultdms_environment }}
SEDOC_REGION={{ vaultdms_region }}
SEDOC_TRUSTED_PROXIES={{ vaultdms_trusted_proxies }}

# DEC-1: the runtime role dms_app (NOBYPASSRLS, owns nothing), over TLS
# with the server certificate verified against the deployment CA.
SEDOC_DATABASE_URL=postgres://{{ vaultdms_db_app_user }}:{{ vault_db_app_password | urlencode | replace('/', '%2F') }}@{{ vaultdms_db_host }}:{{ vaultdms_db_port }}/{{ vaultdms_db_name }}?sslmode={{ vaultdms_db_sslmode }}&sslrootcert={{ vaultdms_db_ca_file }}
SEDOC_REDIS_URL={{ vaultdms_cache_host }}:{{ vaultdms_cache_port }}
SEDOC_NATS_URL={{ vaultdms_nats_url }}
SEDOC_OPENSEARCH_URL={{ vaultdms_search_url }}
SEDOC_S3_ENDPOINT={{ vaultdms_s3_endpoint }}
SEDOC_TEMPORAL_ADDR={{ vaultdms_temporal_addr }}
SEDOC_PUBLIC_URL={{ vaultdms_public_url }}

SEDOC_LOCAL_KEK={{ vault_local_kek }}
SEDOC_GATEWAY_SECRET={{ vault_gateway_secret }}
SEDOC_INTERNAL_API_KEY={{ vault_internal_api_key }}
SEDOC_ESIGN_STATE_HMAC={{ vault_esign_state_hmac }}

# License (ADR 0095, O-10): verified against the release public key.
SEDOC_REQUIRE_LICENSE={{ vaultdms_require_license | bool | lower }}
{% if vaultdms_require_license | bool %}
SEDOC_LICENSE_PUBLIC_KEY_FILE={{ vaultdms_license_public_key_file }}
SEDOC_LICENSE_JWT={{ vault_license_jwt }}
{% endif %}
{% if vaultdms_service_name == 'document' %}

# document: IRM tokens, zero-trust share links, OnlyOffice callbacks.
SEDOC_IRM_SIGNING_KEY={{ vault_irm_signing_key }}
SEDOC_ZT_TOKEN_PEPPER={{ vault_zt_token_pepper }}
SEDOC_ONLYOFFICE_JWT={{ vault_onlyoffice_jwt }}
{% elif vaultdms_service_name == 'audit' %}

# audit: signs chain checkpoints (and the one-time re-baseline,
# docs/runbooks/audit-chain-rebaseline.md).
SEDOC_AUDIT_SIGNING_KEY={{ vault_audit_signing_key }}
{% elif vaultdms_service_name == 'connector' %}

# connector: per-tenant intake folders under this root.
SEDOC_INTAKE_ROOT={{ vaultdms_intake_root }}
{% elif vaultdms_service_name == 'signature' %}

# signature: PAdES seal level; B-T/B-LT need a TSA (boot fails without).
SEDOC_SEAL_LEVEL={{ vaultdms_seal_level }}
SIGNER_TSA_URL={{ vaultdms_signer_tsa_url }}
{% elif vaultdms_service_name == 'billing' %}

SEDOC_STRIPE_WEBHOOK_SECRET={{ vault_stripe_webhook_secret }}
{% endif %}

{% for k, v in vaultdms_service_extra_env.items() %}
{{ k }}={{ v }}
{% endfor %}
