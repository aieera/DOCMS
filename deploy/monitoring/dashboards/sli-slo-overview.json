{
  "__comment": "§15.2 / F3 — one-page dashboard rolling up all 20 blueprint SLIs. Each panel = one SLI, threshold colored against the SLO. PromQL assumes metrics from pkg/health + Kong prometheus plugin + per-service instrumentation. Missing metrics render as 'No data' — use that as a TODO signal, not a bug.",
  "title": "SeDoc — SLI / SLO Overview (§15.2)",
  "uid": "vaultdms-sli-slo",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "tags": ["vaultdms", "sli", "slo"],
  "editable": false,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(http_requests_total, tenant_id)",
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "1. API availability (SLO 99.95%)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "100 * sum(rate(http_requests_total{code!~\"5..\"}[5m])) / sum(rate(http_requests_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 99.5 }, { "color": "green", "value": 99.95 }] } } }
    },
    {
      "id": 2, "type": "stat", "title": "2. Search latency p99 (SLO < 300ms)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(search_request_duration_seconds_bucket[5m]))) * 1000", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 200 }, { "color": "red", "value": 300 }] } } }
    },
    {
      "id": 3, "type": "stat", "title": "3. Upload init latency p99 (SLO < 200ms)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(storage_upload_init_duration_seconds_bucket[5m]))) * 1000", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 150 }, { "color": "red", "value": 200 }] } } }
    },
    {
      "id": 4, "type": "stat", "title": "4. Download URL p99 (SLO < 100ms)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(storage_download_url_duration_seconds_bucket[5m]))) * 1000", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 100 }] } } }
    },
    {
      "id": 5, "type": "stat", "title": "5. OCR processing p95 (SLO < 30s)",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(intelligence_ocr_duration_seconds_bucket[5m])))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 30 }] } } }
    },
    {
      "id": 6, "type": "stat", "title": "6. Document CRUD p99 (SLO < 150ms)",
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(document_crud_duration_seconds_bucket[5m]))) * 1000", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 150 }] } } }
    },
    {
      "id": 7, "type": "stat", "title": "7. Permission check p99 (SLO < 5ms)",
      "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(policy_check_duration_seconds_bucket[5m]))) * 1000", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "id": 8, "type": "stat", "title": "8. WS connection success (SLO 99.9%)",
      "gridPos": { "x": 18, "y": 4, "w": 6, "h": 4 },
      "targets": [{ "expr": "100 * sum(rate(websocket_connections_established_total[5m])) / sum(rate(websocket_connection_attempts_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.9 }] } } }
    },
    {
      "id": 9, "type": "stat", "title": "9. Webhook delivery (SLO 99.5%)",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [{ "expr": "100 * sum(rate(webhook_deliveries_total{result=\"success\"}[15m])) / sum(rate(webhook_deliveries_total[15m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 99 }, { "color": "green", "value": 99.5 }] } } }
    },
    {
      "id": 10, "type": "stat", "title": "10. Search index freshness p95 (SLO < 5s)",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(search_index_lag_seconds_bucket[5m])))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 5 }] } } }
    },
    {
      "id": 11, "type": "stat", "title": "11. Preview gen p95 (SLO < 15s)",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(preview_generation_duration_seconds_bucket[5m])))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 15 }] } } }
    },
    {
      "id": 12, "type": "stat", "title": "12. Login latency p99 (SLO < 500ms)",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(auth_login_duration_seconds_bucket[5m]))) * 1000", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 300 }, { "color": "red", "value": 500 }] } } }
    },
    {
      "id": 13, "type": "stat", "title": "13. Cross-tenant isolation (SLO 0)",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(increase(cross_tenant_access_denied_total[24h]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 14, "type": "stat", "title": "14. Backup success (SLO 99.99%)",
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "100 * sum(backup_success_total) / sum(backup_attempts_total)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 99.9 }, { "color": "green", "value": 99.99 }] } } }
    },
    {
      "id": 15, "type": "stat", "title": "15. Residency compliance (SLO 100%)",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "100 * sum(residency_correct_region_total) / sum(residency_documents_total)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 99.99 }, { "color": "green", "value": 100 }] } } }
    },
    {
      "id": 16, "type": "stat", "title": "16. Audit log completeness (SLO 100%)",
      "gridPos": { "x": 18, "y": 12, "w": 6, "h": 4 },
      "targets": [{ "expr": "100 * sum(rate(audit_events_recorded_total[5m])) / sum(rate(user_actions_total[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 99.9 }, { "color": "green", "value": 100 }] } } }
    },
    {
      "id": 17, "type": "stat", "title": "17. Virus scan coverage (SLO 100%)",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "targets": [{ "expr": "100 * sum(clamav_scans_completed_total) / sum(uploads_total)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 99.9 }, { "color": "green", "value": 100 }] } } }
    },
    {
      "id": 18, "type": "stat", "title": "18. Certs > 30 days (SLO 100%)",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "targets": [{ "expr": "100 * sum(tls_cert_days_remaining >= 30) / count(tls_cert_days_remaining)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "green", "value": 100 }] } } }
    },
    {
      "id": 19, "type": "stat", "title": "19. Error-budget burn rate (SLO < 2.0)",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 },
      "targets": [{ "expr": "( (1 - 0.9995) / (1 - (sum(rate(http_requests_total{code!~\"5..\"}[1h])) / sum(rate(http_requests_total[1h])))) )", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 2 }] } } }
    },
    {
      "id": 20, "type": "stat", "title": "20. MTTD p95 (SLO < 5 min)",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(alert_detection_duration_seconds_bucket[1h]))) / 60", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "m", "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }, { "color": "yellow", "value": 3 }, { "color": "red", "value": 5 }] } } }
    }
  ]
}
