{
  "__comment": "§15.2 / F3 — one-page roll-up of the blueprint SLIs that have a metric today. HTTP availability and latency are measured at the gateway (Kong prometheus plugin, ms); SLIs with no exported metric were removed rather than left as 'No data' (O-3). deploy/monitoring/check-metrics.py fails on any metric nothing emits.",
  "title": "SeDoc — SLI / SLO Overview (§15.2)",
  "uid": "vaultdms-sli-slo",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "tags": [
    "vaultdms",
    "sli",
    "slo"
  ],
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "1. API availability (SLO 99.95%)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 * sum(rate(kong_http_requests_total{code!~\"5..\"}[5m])) / sum(rate(kong_http_requests_total[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 99.5
              },
              {
                "color": "green",
                "value": 99.95
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "2. Search latency p99 (SLO < 300ms)",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(kong_request_latency_ms_bucket{route=\"search\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        }
      }
    },
