{
  "dashboard": {
    "title": "SeDoc Tenant Health (Noisy Neighbor)",
    "uid": "vaultdms-tenant-health",
    "tags": [
      "vaultdms",
      "tenant"
    ],
    "refresh": "30s",
    "panels": [
      {
        "title": "Audit Verifications by Tenant (24h)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum by (tenant_id, result) (increase(audit_verify_total[24h]))",
            "legendFormat": "{{tenant_id}} {{result}}"
          }
        ]
      },
      {
        "title": "Audit Chain Breaks by Tenant",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum by (tenant_id) (audit_chain_break_total) > 0",
            "legendFormat": "{{tenant_id}}"
          }
        ]
      },
      {
        "title": "OCR In-flight by Tenant (Top 10)",
        "type": "bargauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "topk(10, sum by (tenant_id) (ocr_queue_depth))",
            "legendFormat": "{{tenant_id}}"
          }
        ]
      }
    ]
  }
}
