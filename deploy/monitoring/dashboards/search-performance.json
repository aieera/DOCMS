{
  "dashboard": {
    "title": "SeDoc Search Performance",
    "uid": "vaultdms-search",
    "tags": [
      "vaultdms",
      "search"
    ],
    "refresh": "30s",
    "panels": [
      {
        "title": "Search QPS (gateway)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(kong_http_requests_total{route=\"search\"}[5m]))",
            "legendFormat": "QPS"
          }
        ]
      },
      {
        "title": "Search Latency (ms, gateway)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(kong_request_latency_ms_bucket{route=\"search\"}[5m])) by (le))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, sum(rate(kong_request_latency_ms_bucket{route=\"search\"}[5m])) by (le))",
            "legendFormat": "p95"
          }
        ]
      },
      {
        "title": "Permission Propagation Lag (p95, s)",
        "type": "timeseries",
        "gridPos": {
          "h": 4,
          "w": 18,
          "x": 6,
          "y": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(search_permission_propagation_lag_seconds_bucket[5m])) by (le))",
            "legendFormat": "p95"
          }
        ]
      }
    ]
  }
}
