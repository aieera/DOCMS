{
  "dashboard": {
    "title": "SeDoc Intelligence Pipeline",
    "uid": "vaultdms-intelligence",
    "tags": [
      "vaultdms",
      "ai"
    ],
    "refresh": "30s",
    "panels": [
      {
        "title": "OCR Dead Letters (1h) by Reason",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(increase(ocr_dlq_total[1h])) by (reason)",
            "legendFormat": "{{reason}}"
          }
        ]
      },
      {
        "title": "OCR In-flight Tasks",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 8,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum(ocr_queue_depth)",
            "legendFormat": "in flight"
          }
        ]
      }
    ]
  }
}
