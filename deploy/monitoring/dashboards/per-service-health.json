{
  "dashboard": {
    "title": "SeDoc Per-Service Health",
    "uid": "sedoc-service-health",
    "tags": [
      "vaultdms"
    ],
    "timezone": "utc",
    "refresh": "30s",
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "multi": false,
          "query": "label_values(kong_http_requests_total, service)"
        }
      ]
    },
    "panels": [
      {
        "title": "$service — RPS by Status (gateway)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sum(rate(kong_http_requests_total{service=\"$service\"}[5m])) by (code)",
            "legendFormat": "{{code}}"
          }
        ]
      },
      {
        "title": "$service — Latency (ms, gateway)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum(rate(kong_request_latency_ms_bucket{service=\"$service\"}[5m])) by (le))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.99, sum(rate(kong_request_latency_ms_bucket{service=\"$service\"}[5m])) by (le))",
            "legendFormat": "p99"
          }
        ]
      },
      {
        "title": "$service — Error Rate (gateway)",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "sum(rate(kong_http_requests_total{service=\"$service\",code=~\"5..\"}[5m])) / sum(rate(kong_http_requests_total{service=\"$service\"}[5m])) * 100",
            "legendFormat": "5xx %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                {
                  "color": "green",
                  "value": 0
                },
                {
                  "color": "yellow",
                  "value": 0.5
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          }
        }
      }
    ]
  }
}
