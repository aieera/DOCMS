# SeDoc migration runner (H-18): golang-migrate + psql + every service's
# migration track + scripts/migrate-all.sh, so the Helm migrate Job and the
# prod compose `migrate` service run exactly the ordered, per-service-table
# sequence the dev Makefile and install.sh run.
#
#   docker build -f build/Dockerfile.migrate -t ghcr.io/aieera/sedoc/migrate:<tag> .
#
# Runtime contract (env):
#   DATABASE_URL               postgres URL of the migration/owner role
#                              (no password; use PGPASSWORD)
#   PGPASSWORD                 that role's password
#   SEDOC_DB_BOOTSTRAP_ROLES=1 run scripts/db-bootstrap-roles.sql first
#   DMS_APP_PASSWORD           required with the bootstrap
#   DMS_READONLY_PASSWORD      optional (dms_readonly stays NOLOGIN without)
#   DMS_EVIDENCE_PASSWORD      optional (SOC 2 evidence role; NOLOGIN without)
#   DMS_BACKUP_PASSWORD        optional (pg_dump role; NOLOGIN without)

# golang-migrate is built from source rather than copied out of the
# migrate/migrate image: even the newest upstream image (v4.20.1) ships a
# binary built on a Go toolchain and dependency set with fixable HIGH CVEs
# (stdlib, grpc, x/net, x/crypto, klauspost/compress), and it compiles in
# every database/source driver. We only need the postgres driver (lib/pq,
# what migrate-all.sh's postgres:// URLs select) and the file:// source, so
# the build tags keep the binary to exactly that, on the same pinned Go
# toolchain as the services. `go install pkg@version` resolves the module
# through the checksum database, so the version pin is verified.
FROM golang:1.26.10-alpine AS migrate
ARG MIGRATE_VERSION=v4.20.1
RUN CGO_ENABLED=0 GOBIN=/out GOTOOLCHAIN=local go install -trimpath \
        -tags 'postgres file' \
        -ldflags="-s -w -X main.Version=${MIGRATE_VERSION}" \
        github.com/golang-migrate/migrate/v4/cmd/migrate@${MIGRATE_VERSION}

FROM postgres:16-alpine@sha256:f4610795587492cd4fb887c2dc3de301b813278bb6f616992061141b5f15ac36
# gosu exists only for the postgres server entrypoint's root -> postgres
# drop; this image never runs that entrypoint (it runs as 1000:1000), and
# the docker-library build of gosu is on an old Go toolchain (stdlib
# v1.24.6, 25 HIGH + 1 CRITICAL fixable CVEs), so remove it and its
# su-exec alias.
RUN rm -f /usr/local/bin/gosu /usr/local/bin/su-exec
COPY --from=migrate /out/migrate /usr/local/bin/migrate
WORKDIR /opt/sedoc
COPY scripts/migrate-all.sh scripts/db-bootstrap-roles.sql scripts/db-bootstrap-postmigrate.sql ./scripts/
# Only the migration directories, under the same relative paths the script
# expects (services/<svc>/migrations).
COPY services/audit/migrations/        ./services/audit/migrations/
COPY services/auth/migrations/         ./services/auth/migrations/
COPY services/billing/migrations/      ./services/billing/migrations/
COPY services/connector/migrations/    ./services/connector/migrations/
COPY services/document/migrations/     ./services/document/migrations/
COPY services/intelligence/migrations/ ./services/intelligence/migrations/
COPY services/notification/migrations/ ./services/notification/migrations/
COPY services/search/migrations/       ./services/search/migrations/
COPY services/task/migrations/         ./services/task/migrations/
USER 1000:1000
ENTRYPOINT ["/bin/bash", "/opt/sedoc/scripts/migrate-all.sh"]
