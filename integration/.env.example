# Copy to .env before `docker compose up`. The integration needs a running SeDoc
# plus an API key (scopes: documents:read, documents:write, upload) and a target
# workspace id. Mint these via SeDoc admin / the seed tooling in the parent repo.

SEDOC_API_KEY=vdms_replace_me
SEDOC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Where the integration reaches SeDoc. Defaults assume the host's SeDoc via
# host.docker.internal (document gateway on :8080, search on :8086). To join the
# parent compose network instead, point these at the in-network service names.
# SEDOC_BASE_URL=http://host.docker.internal:8080/api/v1
# SEDOC_SEARCH_URL=http://host.docker.internal:8086/api/v1

# Proactive write throttle — keep under SeDoc's 600/min :upsert/ingest ceiling.
# A single shared limiter caps the event worker + backfill combined.
# SEDOC_INTEGRATION_RATE_PER_MIN=600
# SEDOC_INTEGRATION_RATE_BURST=20

# Backfill: customers processed in parallel (SeDoc write rate still capped above).
# SEDOC_INTEGRATION_BACKFILL_CONCURRENCY=4
# Mock ERP only: how many seed customers GET /erp/customers returns.
# ERP_SEED_CUSTOMERS=3

# BFF only: where to reach the worker for the /files/sync/metrics passthrough.
# SEDOC_INTEGRATION_WORKER_URL=http://localhost:8090

# ERP boundary (render/authz/listing). Default = the mock (cmd/mockerp). For the
# real-ERP cutover, point at the live ERP and (if it requires auth) set a token —
# this is the entire mock→real switch, no code change. See ERP-CONTRACT.md.
# ERP_BASE_URL=http://localhost:8095
# ERP_API_TOKEN=                       # bearer presented to the ERP; empty = none (mock)
