# VaultDMS web — local development environment.
#
# Copy this file to .env.local (gitignored) and fill in the values.
# Vite picks .env.local up automatically; .env is for shared defaults
# only and must never contain secrets.

# Gateway signature for the Vite dev proxy. The Go services'
# pkg/middleware.RequireGatewaySignature middleware accepts the
# request only when X-Gateway-Signature matches this value. In
# host-mode dev (`make run-all`) the Vite proxy injects this header;
# in compose-only dev (`make docker-up`) Kong injects it instead.
#
# Generate a fresh value with:   openssl rand -hex 32
# Use the SAME value in scripts/run-all-services.sh's
# SEDOC_GATEWAY_SECRET export.
SEDOC_GATEWAY_SECRET=

# Optional: pin the Vite proxy to gateway mode (route every /api
# request through Kong on :8080 instead of per-prefix host routing).
# Leave unset for the default host-mode behaviour.
# VITE_PROXY_MODE=gateway
# VITE_GATEWAY_URL=http://localhost:8080
