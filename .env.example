# VaultDMS — environment template. Copy to .env and fill in real values.
# NEVER commit .env.

# ---- Image registry & version ----
REGISTRY=ghcr.io/vaultdms
VERSION=dev

# ---- Postgres ----
POSTGRES_DB=vaultdms
POSTGRES_USER=vaultdms
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://vaultdms:changeme@postgres:5432/vaultdms?sslmode=disable

# ---- Redis ----
REDIS_URL=redis://:changeme@redis:6379/0
REDIS_PASSWORD=changeme

# ---- NATS ----
NATS_URL=nats://nats:4222

# ---- MinIO / S3 ----
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=vaultdms
MINIO_ROOT_PASSWORD=changeme
MINIO_USE_SSL=false

# ---- OpenSearch ----
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_ADMIN_PASSWORD=ChangeMe_Strong_1!

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333

# ---- Temporal ----
TEMPORAL_ADDR=temporal:7233

# ---- ClamAV ----
CLAMAV_ADDR=clamav:3310

# ---- Inter-service addresses (non-prefixed by convention) ----
POLICY_SERVICE_ADDR=policy:9090

# ---- Crypto / KMS ----
# For LocalKeyManager (dev only). Use Vault or AWS KMS in prod.
VAULTDMS_LOCAL_KEK=

# ---- Public reachability ----
# Externally-reachable base URL of the platform (auth redirects + share
# links embed this). REQUIRED in production; dev can leave blank.
VAULTDMS_PUBLIC_URL=http://localhost:8080

# HTTP cookie signing secret. Generated by scripts/gen-dev-env.sh.
SESSION_COOKIE_SECRET=

# §3.1 / B2.3 — gateway-signature shared secret. Kong injects this as
# X-Gateway-Signature on every forwarded request; every backend
# (pkg/middleware.RequireGatewaySignature) rejects unsigned traffic.
# MUST be identical in the gateway and every backend process. Generate
# with `openssl rand -base64 48`. Required.
VAULTDMS_GATEWAY_SECRET=

# Optional: override S3 endpoint host in presigned URLs (reverse-proxy setups).
VAULTDMS_S3_PUBLIC_BASE=

# ---- Billing secrets ----
# Internal API key for billing /internal/v1 routes. REQUIRED in prod.
VAULTDMS_INTERNAL_API_KEY=

# Stripe webhook signing secret (whsec_...). REQUIRED when billing is enabled.
STRIPE_WEBHOOK_SECRET=

# ---- Logging ----
LOG_LEVEL=info

# ---- Seed (optional — defaults used if unset) ----
# The seed script reads these on `make seed` to create the default tenant
# and admin user. In production you MUST override SEED_ADMIN_PASSWORD to a
# random value OR skip seeding entirely.
SEED_ADMIN_EMAIL=admin@acme.local
SEED_ADMIN_PASSWORD=ChangeMe!Now2026
SEED_TENANT_SLUG=acme
SEED_TENANT_NAME=Acme Corporation
SEED_REGION=me-central-1
