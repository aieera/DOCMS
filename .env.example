# SeDoc — environment template. Copy to .env and fill in real values.
# NEVER commit .env.

# ---- Environment (C-2) ----
# dev | staging | prod — validated by every Go service. dev enables the
# public dev secrets (OnlyOffice JWT, zt pepper, IRM key, DSR salt
# fallbacks); staging/prod require the real ones and also turn on the Secure
# session cookie, OpenSearch TLS verification and the production secret
# checks (SEDOC_LOCAL_KEK, SEDOC_PUBLIC_URL, Stripe). An UNSET value counts
# as not-dev for those fallbacks, so host-mode `make run-all` (which sources
# this file) needs it spelled out. docker-compose.prod.yml forces prod
# regardless of this line.
SEDOC_ENVIRONMENT=dev

# ---- Image version (prod override) ----
# docker-compose.prod.yml pulls ghcr.io/aieera/sedoc/<svc>:$VERSION
# (including the `migrate` and `web` images). REQUIRED for prod; unused by
# the dev stack, which builds from source.
VERSION=

# ---- Postgres (prod override) ----
# The dev stack hard-codes sedoc/devpassword; these are read only by
# docker-compose.prod.yml. POSTGRES_USER is the owner/migration role (a
# superuser: later migrations create BYPASSRLS definer roles).
POSTGRES_DB=sedoc
POSTGRES_USER=sedoc
POSTGRES_PASSWORD=
# DEC-1 / O-6 — runtime role. Every service connects as dms_app
# (NOBYPASSRLS); the one-shot `migrate` service gives it LOGIN with this
# password. Embedded in URLs: use a URL-safe value (openssl rand -hex 24).
# REQUIRED for prod.
DMS_APP_PASSWORD=
# Optional: LOGIN for the read-only analytics role (stays NOLOGIN if blank).
DMS_READONLY_PASSWORD=

# ---- Redis (prod override) ----
# requirepass for Redis; Go services get SEDOC_REDIS_PASSWORD, the Python
# and Node services a redis://:PASSWORD@redis:6379/N URL, so URL-safe (hex).
# REQUIRED for prod.
REDIS_PASSWORD=

# ---- NATS ----
# O-4 — the bus requires user/password (deploy/nats/nats.conf). Compose
# builds SEDOC_NATS_URL=nats://USER:PASSWORD@nats:4222 from these, so use a
# URL-safe password (openssl rand -hex 24). Blank = dev defaults
# (sedoc / dev-nats-password); the prod override refuses to start without
# a password. Host-mode `make run-all` needs
# SEDOC_NATS_URL=nats://USER:PASSWORD@localhost:4222 in its environment.
SEDOC_NATS_USER=
SEDOC_NATS_PASSWORD=

# ---- MinIO / S3 (prod override) ----
# MinIO root credentials; the prod override also hands them to the services
# as their S3 keys. REQUIRED for prod (dev uses minioadmin/minioadmin).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---- OpenSearch (prod override) ----
# Initial admin password (the node is internal-only, plain http).
OPENSEARCH_ADMIN_PASSWORD=

# ---- Published ports (H-23) ----
# DEV stack only: interface for MinIO :9000 (presigned URLs) and OnlyOffice
# :8195. Default 127.0.0.1; a LAN dev/test server that serves remote
# browsers directly needs 0.0.0.0. The prod override ignores it: there web,
# MinIO and OnlyOffice are loopback-only behind the host's TLS proxy, which
# must serve SEDOC_S3_PUBLIC_BASE (presigned URLs are signed for that host).
SEDOC_PUBLIC_BIND=
# Prod override only: interface for the Kong gateway (default 0.0.0.0; use
# 127.0.0.1 when the TLS reverse proxy runs on this host).
SEDOC_GATEWAY_BIND=
# Prod override only: the compose network's subnet and Kong's fixed address
# in it (backends trust X-Forwarded-For only from that address). Change both
# together if 10.231.0.0/24 collides with your network.
SEDOC_COMPOSE_SUBNET=
SEDOC_GATEWAY_IP=

# ---- Region ----
# Deployment region the services read (pkg/config `region`). Storage only
# accepts uploads pinned to it (bucket dms-<region>-hot) and the document
# service falls back to it for a new document's region_pin, so both MUST
# agree. Blank = us-east-1 (the dev MinIO buckets).
SEDOC_REGION=

# ---- Client IP (DEC-5) ----
# CIDRs whose X-Forwarded-For the backends trust when resolving the client
# IP for audit rows and rate limits (comma-separated). Blank in dev compose
# = the docker bridge ranges (172.16.0.0/12). Must cover Kong / the ingress
# and nothing a client controls.
SEDOC_TRUSTED_PROXIES=
# Peers Kong itself trusts for X-Forwarded-For (KONG_TRUSTED_IPS): your load
# balancer / reverse proxy. Blank in dev compose = 172.16.0.0/12.
SEDOC_KONG_TRUSTED_IPS=

# ---- Signatures ----
# Server-seal PAdES level: B-B | B-T | B-LT (code default B-LT). B-T and
# B-LT need a timestamp authority (SIGNER_TSA_URL) or the signature service
# refuses to start. Blank in dev compose = B-B.
SEDOC_SEAL_LEVEL=
SIGNER_TSA_URL=

# ---- Crypto / KMS ----
# Base64 32-byte AES key (openssl rand -base64 32) wrapping the per-tenant
# KEKs. REQUIRED outside dev: storage refuses to start without a key manager
# unless SEDOC_STORAGE_ENCRYPT_AT_REST=false is set explicitly, the connector
# always needs it, and the intelligence / preview workers must hold the SAME
# value to decrypt blobs. Vault / AWS KMS are not wired in storage yet.
SEDOC_LOCAL_KEK=

# ---- Public reachability ----
# Externally-reachable base URL of the platform (auth redirects + share
# links embed this). REQUIRED in production; dev can leave blank.
SEDOC_PUBLIC_URL=http://localhost:8080

# HTTP cookie signing secret. Generated by scripts/gen-dev-env.sh.
SESSION_COOKIE_SECRET=

# §3.1 / B2.3 — gateway-signature shared secret. Kong injects this as
# X-Gateway-Signature on every forwarded request; every backend
# (pkg/middleware.RequireGatewaySignature) rejects unsigned traffic.
# MUST be identical in the gateway and every backend process. Generate
# with `openssl rand -hex 32` (hex: deploy/gateway/entrypoint.sh substitutes
# it with sed). Required.
SEDOC_GATEWAY_SECRET=

# LLM credential fallback. Code default is FALSE: a tenant with no API key
# gets "AI disabled" instead of silently using the deploy's provider keys
# (tenant content on the operator's account — fails enterprise DPA review).
# docker-compose defaults this to true for dev convenience; set false when
# the stack fronts real customers.
SEDOC_LLM_ALLOW_DEPLOY_CREDENTIALS=

# Address CLIENTS reach MinIO/S3 at; presigned upload/download URLs are
# signed against it (SigV4 binds the Host — it cannot be rewritten later).
# Empty = compose default "localhost:9000", which is correct ONLY when every
# client runs on this machine. If anything remote uses the DMS (LAN browsers,
# the ERP integration), set this to this host's reachable address, e.g.
#   SEDOC_S3_PUBLIC_BASE=192.168.70.237:9000
SEDOC_S3_PUBLIC_BASE=

# ---- ERP integration (optional) ----
# Base URL of the ERP-side DMS BFF adapter. docker-compose defaults this to a
# dev-LAN address (http://192.168.70.22:18091) that resolves NOWHERE outside
# that LAN — on any test server either set it to your BFF or leave the ERP
# proxy features unused (they fail gracefully when unreachable).
SEDOC_INTEGRATION_BFF_URL=

# ---- Service-to-service secrets ----
# X-Internal-Service-Key: header identity from in-cluster callers is honoured
# only with this key (DEC-3); also billing /internal/v1, retention sweep,
# workflow/search/connector/intelligence/preview internal calls. Every
# service must hold the same value. REQUIRED in prod.
SEDOC_INTERNAL_API_KEY=
# X-Service-Key for the document -> preview watermark call. REQUIRED in prod.
SEDOC_SERVICE_API_KEY=

# Stripe webhook signing secret (whsec_...). REQUIRED in prod: billing
# refuses to boot without it when SEDOC_ENVIRONMENT=prod.
STRIPE_WEBHOOK_SECRET=

# ---- Document service secrets (required outside dev; 503 otherwise) ----
# IRM export signing key.
SEDOC_IRM_SIGNING_KEY=
# Pepper for zero-trust share tokens. Setting or ROTATING it invalidates
# every zt link minted under the previous value (links live 72 h).
SEDOC_ZT_TOKEN_PEPPER=
# OnlyOffice JWT shared with the document server; must not be the dev
# default "dev-only-onlyoffice-jwt-rotate-in-prod".
SEDOC_ONLYOFFICE_JWT=
# GDPR DSR anonymisation salt (openssl rand -hex 32). Blank in dev = the old
# built-in dev salt; REQUIRED in prod. Set it once: changing it changes every
# pseudonym produced afterwards.
SEDOC_DSR_ANONYMIZE_SALT=
# e-discovery export signing key (openssl rand -hex 32). Blank in dev = the
# gateway secret; REQUIRED in prod.
SEDOC_EDISCOVERY_SIGNING_KEY=
# URL the browser loads OnlyOffice from (prod: your TLS host for :8195).
SEDOC_ONLYOFFICE_PUBLIC_URL=

# ---- Signer keystore (prod override) ----
# Host path of the PKCS#12 the PAdES signer signs with, and its password.
# There is no default password and the baked dev key is refused outside dev.
SIGNER_KEYSTORE_FILE=
SIGNER_KEYSTORE_PASS=

# ---- Auth ----
# Required (>= 32 bytes) whenever SEDOC_WEBAUTHN_RPID is set.
SEDOC_WEBAUTHN_HMAC_SECRET=

# ---- Collaboration ----
# Exact browser origins (scheme://host[:port], comma-separated) allowed to
# open cookie-authenticated /ws and /yjs upgrades. Blank in dev =
# http://localhost:3000,http://127.0.0.1:3000; REQUIRED for prod (your
# public origin, e.g. https://dms.example.com).
SEDOC_ALLOWED_ORIGINS=

# Records cutoff sweep (`docker compose --profile cron run --rm
# records-cutoff-sweep`): space-separated tenant UUIDs.
SEDOC_SWEEP_TENANT_IDS=

# ---- Connector ----
# Allow webhooks to plain-http / private-IP receivers (on-prem ERP on the
# LAN). Dev compose sets true; the prod override defaults to false.
SEDOC_WEBHOOK_ALLOW_PRIVATE=

# ---- Tracing ----
# Dev compose exports every span to the bundled jaeger; the prod override
# defaults tracing off (set SEDOC_TRACING_ENABLED=1 and an OTLP endpoint,
# or enable the `tracing` profile).
SEDOC_TRACING_ENABLED=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Seed (optional — defaults used if unset) ----
# The seed script reads these on `make seed` to create the default tenant
# and admin user. In production you MUST override SEED_ADMIN_PASSWORD to a
# random value OR skip seeding entirely.
SEED_ADMIN_EMAIL=admin@acme.local
SEED_ADMIN_PASSWORD=ChangeMe!Now2026
SEED_ADMIN_NAME=Admin User
SEED_TENANT_SLUG=acme
SEED_TENANT_NAME=Acme Corporation
SEED_REGION=me-central-1

# ---- LLM NER (ADR 0061 — opt-in per tenant via /admin/intelligence/ner-config)
# Per-tenant LLM keys are saved through the admin UI and stored encrypted
# in ner_config (AES-256-GCM under SEDOC_LOCAL_KEK above). The env
# vars below are an *optional* deployment-wide fallback litellm reads
# directly when no per-tenant key is configured. For most operators
# the UI flow is preferred; leave these blank.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
