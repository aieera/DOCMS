<?xml version="1.0" encoding="UTF-8"?>
<!--
  SeDoc — Outlook add-in manifest (ADR 0112).

  Manifest format: legacy XML schema (xsi:type="MailApp").
  Why XML and not the unified JSON manifest?
    * Mobile + the macOS Outlook desktop client still require the
      XML schema as of mid-2026; JSON is web + new-Outlook-only.
    * The MessageReadCommandSurface extension point is well-supported
      in XML and not yet 1:1 in JSON.
  Migration to JSON happens when mobile + macOS catch up.

  Build-time substitution (see webpack.config.js — copy-webpack-plugin
  transform): the ${...} tokens below are replaced from env at build time
  so no per-deployment value is committed:
    * ${SEDOC_ADDIN_HOST}      — the HTTPS host serving the static bundle
                                  (prod: CDN; dev: HTTPS loopback from
                                  `npm run dev`). Defaults to
                                  addin.vaultdms.example.com when unset.
    * ${SEDOC_AAD_CLIENT_ID}   — the Microsoft Entra (Azure AD) application
                                  (client) ID of the SeDoc API app
                                  registration. Per-tenant; the operator's
                                  own app registration.
  The add-in <Id> below is a STABLE canonical GUID (the add-in's identity).
  Override it via ${SEDOC_ADDIN_ID} only when sideloading multiple envs on
  one machine (Outlook refuses a duplicate GUID in the same catalog).
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
  xsi:type="MailApp">

  <!-- Canonical add-in identity (stable). ${SEDOC_ADDIN_ID} lets a dev
       machine override it to avoid a duplicate-GUID clash when sideloading
       multiple environments at once. -->
  <Id>${SEDOC_ADDIN_ID:-2bcd772e-ec09-4254-bbb5-2919adab8523}</Id>
  <Version>0.1.0.0</Version>
  <ProviderName>SeDoc</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Save to SeDoc" />
  <Description DefaultValue="Save the open email and its attachments to a SeDoc workspace." />
  <IconUrl DefaultValue="https://${SEDOC_ADDIN_HOST}/assets/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://${SEDOC_ADDIN_HOST}/assets/icon-128.png" />
  <SupportUrl DefaultValue="https://${SEDOC_DOCS_HOST:-docs.vaultdms.example.com}/outlook-addin" />

  <!-- Read-mode only. Save during compose lands in Phase 2. -->
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://${SEDOC_ADDIN_HOST}/taskpane.html" />
        <RequestedHeight>320</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteMailbox</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <!-- Version 1.1 overrides — ribbon button + SSO + run-time
       permissions. The MessageReadCommandSurface is where the
       "Save to SeDoc" button lives. -->
  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">
    <VersionOverrides
      xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1"
      xsi:type="VersionOverridesV1_1">

      <!-- SSO via Microsoft Entra ID. Resource = the SeDoc API
           app registration in Entra (Application (client) ID).
           Scope = openid + profile + email (we exchange the token
           server-side for a SeDoc session, so the Graph scopes
           don't need to live on this app registration). -->
      <WebApplicationInfo>
        <Id>${SEDOC_AAD_CLIENT_ID}</Id>
        <Resource>api://${SEDOC_ADDIN_HOST}/${SEDOC_AAD_CLIENT_ID}</Resource>
        <Scopes>
          <Scope>openid</Scope>
          <Scope>profile</Scope>
          <Scope>email</Scope>
          <Scope>User.Read</Scope>
        </Scopes>
      </WebApplicationInfo>

      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>

      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="commandsFile.url" />

            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="vaultdmsGroup">
                  <Label resid="groupLabel" />
                  <Control xsi:type="Button" id="saveToSeDocButton">
                    <Label resid="saveBtnLabel" />
                    <Supertip>
                      <Title resid="saveBtnTitle" />
                      <Description resid="saveBtnDesc" />
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16" />
                      <bt:Image size="32" resid="icon32" />
                      <bt:Image size="80" resid="icon80" />
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="taskpaneURL" />
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>

      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://${SEDOC_ADDIN_HOST}/assets/icon-16.png" />
          <bt:Image id="icon32" DefaultValue="https://${SEDOC_ADDIN_HOST}/assets/icon-32.png" />
          <bt:Image id="icon80" DefaultValue="https://${SEDOC_ADDIN_HOST}/assets/icon-80.png" />
        </bt:Images>
        <bt:Urls>
          <bt:Url id="commandsFile.url" DefaultValue="https://${SEDOC_ADDIN_HOST}/commands.html" />
          <bt:Url id="taskpaneURL"      DefaultValue="https://${SEDOC_ADDIN_HOST}/taskpane.html" />
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel"   DefaultValue="SeDoc" />
          <bt:String id="saveBtnLabel" DefaultValue="Save to SeDoc" />
          <bt:String id="saveBtnTitle" DefaultValue="Save to SeDoc" />
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="saveBtnDesc" DefaultValue="Save this email and its attachments to a SeDoc workspace." />
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
